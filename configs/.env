# ── Supabase (dev) ───────────────────────────────────────────────────────────
SUPABASE_HOST=db.<PROJECT_ID>.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=<PASSWORD>

# ── Spotify API ───────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=<SPOTIFY_CLIENT_ID>
SPOTIFY_CLIENT_SECRET=<SPOTIFY_CLIENT_SECRET>

# ── Pipeline knobs ────────────────────────────────────────────────────────────
MPD_ROOT=/path/to/mpd/data/dev_slice      # folder containing mpd.slice.*.json
BATCH_SIZE=50                              # Spotify API max per /audio-features call
UPSERT_BATCH=500                           # rows per Postgres COPY batch
MAX_WORKERS=4                              # concurrent enrichment threads
LOG_LEVEL=INFO

